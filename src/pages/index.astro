---
import Layout from "@/layouts/Layout.astro";
import DitherHero from "@/components/DitherHero.astro";
---

<Layout title="Borworntat D.">
  <DitherHero />
  <main class="content flex min-h-screen flex-col px-6 py-10 md:px-12">
    <h2 class="font-mono text-4xl font-bold md:text-6xl">Hello there</h2>
    <p class="mt-4 text-lg md:text-2xl">Welcome to Borworntat D.'s page</p>
    <p class="mt-6 text-lg md:text-xl">
      I'm a senior{" "}
      <span class="box-decoration-clone bg-[#8B2332] px-0.5 text-[#fff8fc]"
        ><a class="hover:underline" href="https://www.cp.eng.chula.ac.th/">computer</a>{" "}<a
          class="hover:underline"
          href="https://www.eng.chula.ac.th/">engineering</a
        ></span
      >{" "}
      student at{" "}
      <a
        class="box-decoration-clone bg-[#DE5C8E] px-0.5 text-white hover:underline"
        href="https://www.chula.ac.th/">Chulalongkorn University</a
      >. Together with my friends, I do{" "}
      <a class="underline" href="https://scholar.google.com/citations?user=9laI04cAAAAJ&hl=en"
        >research</a
      > in computer graphics and related fields, advised by{" "}
      <a class="underline" href="https://www.cp.eng.chula.ac.th/about/faculty/pizzanuk"
        >Assoc.&nbsp;Prof.&nbsp;Pizzanu&nbsp;K.</a
      >
    </p>
    <p class="mt-4 text-lg md:text-xl">
      Within the department, I'm a{" "}
      <a class="underline" href="https://borworntat.com/assistant/">teaching assistant</a> for
      Data Structures, Algorithm Design and Computer Graphics, and I administer its HPC cluster. In
      2026, I received the department's Outstanding Student Award.
    </p>
    <p class="mt-4 text-lg md:text-xl">
      Across campus, I'm the lead frontend engineer at{" "}
      <a class="underline" href="https://isd.sgcu.in.th/">ISD SGCU</a>, the Information System
      Development Department of the Student Government of Chulalongkorn University.
    </p>
    <p class="mt-4 text-lg md:text-xl">
      Outside the university, I set problems for the IOI Thailand selection process as part of
      the{" "}
      <a class="underline" href="https://thailand-oi-task-team.github.io/">IOI Thailand Task Team</a
      >.
    </p>
    <nav class="mt-auto flex gap-6 pt-10 font-mono text-sm">
      <a class="underline" href="/garden">garden</a>
      <a class="underline" href="/garden/posts">blog</a>
      <a class="underline" href="https://github.com/MasterIceZ">github</a>
    </nav>
  </main>
</Layout>

<style>
  :global(body) {
    background: var(--dh-paper);
    color: var(--dh-ink);
  }
  .content {
    position: relative;
  }
  /* Leave room for the docked panel: a left column on desktop, a top band on mobile. */
  :global(html.js) .content {
    padding-top: calc(30vh + 2.5rem);
  }
  @media (min-width: 768px) {
    :global(html.js) .content {
      margin-left: 40vw;
      padding-top: 2.5rem;
    }
  }
</style>
